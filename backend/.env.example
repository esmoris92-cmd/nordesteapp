# Copia este archivo como ".env" (en esta misma carpeta) y ajusta los valores.
# El archivo .env NO se guarda en Git (está en .gitignore). Nunca subas claves reales.
# Todos los valores de este ejemplo son ficticios.

# Entorno: "development" (tu computadora) o "production" (servidor real).
ENVIRONMENT=development

# Conexión a PostgreSQL: usuario, contraseña, servidor, puerto y nombre de la base.
# Usa la misma contraseña que elijas al crear el usuario "medflow" (ver docs/INSTALACION.md).
DATABASE_URL=postgresql+psycopg://medflow:cambia-esta-clave-local@localhost:5432/medflow

# Base de datos SOLO para pruebas automáticas. Debe terminar en "_test":
# las pruebas borran su contenido en cada ejecución.
TEST_DATABASE_URL=postgresql+psycopg://medflow:cambia-esta-clave-local@localhost:5432/medflow_test

# Sesiones: duración máxima (horas) y cierre por inactividad (minutos).
SESSION_MAX_HOURS=8
SESSION_IDLE_MINUTES=60

# En producción con HTTPS debe ser true (la cookie solo viaja cifrada).
COOKIE_SECURE=false

# Contraseña de las cuentas de demostración que crea "python -m app.seed".
# Es solo para datos ficticios locales; no reutilices una contraseña real.
DEMO_PASSWORD=MedFlow-Demo-2026

# Carpeta para los archivos adjuntos de pacientes y tamaño máximo por archivo (MB).
# Por defecto: backend/storage/files (está en .gitignore; no se sube a GitHub).
# FILES_DIR=/ruta/a/una/carpeta/privada
MAX_UPLOAD_MB=10

# Carpeta de las copias de seguridad (bash scripts/copia-seguridad.sh).
# Por defecto: ~/MedFlow-copias, FUERA del proyecto para que nunca se suban a GitHub.
# Contienen datos de pacientes: guárdalas en un disco cifrado (FileVault o un disco externo cifrado).
# BACKUP_DIR=/ruta/a/una/carpeta/privada
