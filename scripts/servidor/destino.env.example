# Servidor de Nordeste. Copiá este archivo como scripts/servidor/destino.env y completalo.
# destino.env no se sube a Git. Lo usan actualizar.sh, dueno-sistema.sh y copias-del-servidor.sh.
NORDESTE_SERVIDOR=      # IP del servidor, por ejemplo 164.90.123.45
NORDESTE_USUARIO=       # usuario con sudo en el servidor
NORDESTE_PUERTO=22      # puerto SSH
NORDESTE_SITIO=         # dominio, por ejemplo app.nordeste.com.uy (varios separados por comas)
